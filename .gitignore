# Whitelist: only secret-free omp configuration is versioned.
# Excluded on purpose:
#   agent/mcp.json      OAuth client secret (repo is public)
#   *.db, sessions, logs, cache, run, profiles, natives, puppeteer: runtime state
#   agent/extensions/   installed and updated by Orca
#   browser-relay/, plugins/: installed by omp
/*
!/.gitignore
!/extensions/

!/agent/
/agent/*
!/agent/config.yml
!/agent/keybindings.yml
!/agent/agents/
